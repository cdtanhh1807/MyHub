# Bắt buộc: sinh khóa riêng; xem README. Không dùng giá trị mẫu làm bí mật.
JWT_SECRET_KEY=
ENCRYPTION_KEY=
MONGODB_URI=mongodb://myhub_app:URL_ENCODED_PASSWORD@localhost:27017/myhub?authSource=myhub
MONGODB_DB_NAME=myhub
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# SSE dùng Mongo sẵn có; webhook chỉ bật khi BACKEND_URL là HTTPS public truy cập được từ Google.
DRIVE_SYNC_ENABLED=true
DRIVE_SYNC_INTERVAL_SECONDS=300
DRIVE_WEBHOOK_ENABLED=false
SYNC_HISTORY_SIZE=256
SYNC_HEARTBEAT_SECONDS=25
SYNC_MAX_CONNECTIONS_PER_USER=8
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAIL=cdtanhh@gmail.com
ALLOWED_GITHUB_USERNAME=cdtanhh1807
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
DRIVE_SYSTEM_FOLDER_NAME=.myhub-system
LOCAL_DATA_DIR=../data
MAX_EDIT_FILE_SIZE_MB=5
PDF_CACHE_MAX_MB=256
ARCHIVE_MAX_MB=2048
ARCHIVE_MAX_FILES=10000
ARCHIVE_TIMEOUT_SECONDS=1800
# Đường dẫn tuyệt đối nếu công cụ không có trong PATH; không cần dấu ngoặc kép.
SEVEN_ZIP_PATH=7z
RAR_PATH=rar
# Đổi từng phần mở rộng sang drive nếu phân trang PDF không phù hợp.
OFFICE_PREVIEW_RULES={"docx":"pdf","xlsx":"pdf","xls":"pdf","pptx":"pdf","ppt":"pdf"}
